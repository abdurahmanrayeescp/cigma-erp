# ─── Server ───────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/cigma_erp

# ─── JWT Authentication ───────────────────────────────────────────────
JWT_SECRET=your_strong_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_strong_refresh_secret_here_min_32_chars

# ─── Cloudinary (for gallery & file uploads) ─────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Nodemailer) ───────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=creativekidskannur@gmail.com
EMAIL_PASS=your_app_password_here
